{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated dataset metadata",
  "description": "Every file in data/generated/ wraps its records in this metadata envelope.",
  "type": "object",
  "required": ["meta", "records"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["source", "source_url", "licence", "retrieved_at", "refresh_cadence"],
      "properties": {
        "source": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "licence": { "type": "string" },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "refresh_cadence": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly", "quarterly", "annually"]
        },
        "schema": { "type": "string" }
      }
    },
    "records": { "type": "array" }
  }
}
