{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UK Bank Holidays",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["jurisdiction", "dates"],
    "properties": {
      "jurisdiction": { "enum": ["england-and-wales", "scotland", "northern-ireland"] },
      "dates": {
        "type": "array",
        "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
